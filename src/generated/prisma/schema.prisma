generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CareerPath {
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketCategory {
  SERVICE_DESK
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketSeverity {
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  OPEN
  RESOLVED
  BOUNCED
  FAILED
  EXPIRED
}

enum PvPAttackType {
  PASSWORD_RESET_FLOOD
  NETWORK_OUTAGE
  FAILED_DEPLOYMENT
  PHISHING_CAMPAIGN
  TICKET_STORM
  MAJOR_INCIDENT
}

enum PvPAttackStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Player {
  id Int @id @default(autoincrement())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username String @unique

  // Career
  level      Int         @default(1)
  xp         Int         @default(0)
  careerPath CareerPath?

  // Credits are effectively the player's health
  credits Int @default(1000)

  // PvP
  kills        Int @default(0)
  bankruptcies Int @default(0)

  // PvP attack relationships
  attacksSent     PvPAttack[] @relation("AttacksSent")
  attacksReceived PvPAttack[] @relation("AttacksReceived")

  // Tickets originally created by this player as PvP attacks
  attackTickets Ticket[] @relation("AttackTickets")

  // Ticket performance
  ticketsResolved   Int @default(0)
  correctBounces    Int @default(0)
  incorrectBounces  Int @default(0)
  incorrectResolves Int @default(0)

  // Lifetime statistics
  lifetimeCreditsEarned  Int @default(0)
  lifetimeTicketsHandled Int @default(0)

  // Player activity
  lastActiveAt DateTime @default(now())

  // Personal queue slowdown
  queuePenaltyUntil DateTime?

  // Controls next automatic ticket
  nextTicketAt DateTime?

  // Ticket relationships
  assignedTickets Ticket[] @relation("AssignedTickets")
  sentTickets     Ticket[] @relation("SentTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id Int @id @default(autoincrement())

  title       String
  description String

  // Hidden correct resolver
  category TicketCategory

  // Visible urgency
  severity TicketSeverity @default(P4)

  // Hidden internal difficulty
  difficulty Int @default(1)

  status TicketStatus @default(OPEN)

  maxValue Int
  baseXp   Int @default(10)

  // Optional ticket-specific outcome messages
  successMessage String?
  failureMessage String?

  // Player who currently has the ticket
  assignedToId Int
  assignedTo   Player @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: Cascade)

  // Most recent player who bounced/transferred the ticket
  lastSentById Int?
  lastSentBy   Player? @relation("SentTickets", fields: [lastSentById], references: [id], onDelete: SetNull)

  // Original PvP attacker
  attackSourcePlayerId Int?
  attackSourcePlayer   Player? @relation("AttackTickets", fields: [attackSourcePlayerId], references: [id], onDelete: SetNull)

  // PvP attack event that created this ticket
  pvpAttackId Int?
  pvpAttack   PvPAttack? @relation(fields: [pvpAttackId], references: [id], onDelete: SetNull)

  bounceCount Int @default(0)

  // Abandonment / SLA tracking
  abandonmentPenaltyApplied Boolean   @default(false)
  abandonmentPenaltyAt      DateTime?

  resolvedAt DateTime?
  expiredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([lastSentById])
  @@index([attackSourcePlayerId])
  @@index([pvpAttackId])
  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([difficulty])
  @@index([abandonmentPenaltyApplied])
}

model TicketTemplate {
  id Int @id @default(autoincrement())

  title       String
  description String

  // Hidden correct resolver
  category TicketCategory

  // Visible urgency
  severity TicketSeverity @default(P4)

  // Hidden internal difficulty
  difficulty Int @default(1)

  maxValue Int
  baseXp   Int @default(10)

  // Optional ticket-specific outcome messages
  successMessage String?
  failureMessage String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([severity])
  @@index([difficulty])
  @@index([active])
}

model PvPAttack {
  id Int @id @default(autoincrement())

  type   PvPAttackType
  status PvPAttackStatus @default(ACTIVE)

  // Credits paid by attacker
  cost Int

  // Player who purchased the attack
  attackerId Int
  attacker   Player @relation("AttacksSent", fields: [attackerId], references: [id], onDelete: Cascade)

  // Original victim
  targetId Int
  target   Player @relation("AttacksReceived", fields: [targetId], references: [id], onDelete: Cascade)

  // Tickets created by this attack
  tickets Ticket[]

  // True if this attack caused bankruptcy
  causedBankruptcy Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attackerId])
  @@index([targetId])
  @@index([type])
  @@index([status])
  @@index([causedBankruptcy])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  player Player?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
