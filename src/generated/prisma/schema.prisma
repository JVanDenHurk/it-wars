generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CareerPath {
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketCategory {
  SERVICE_DESK
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketStatus {
  OPEN
  RESOLVED
  BOUNCED
  FAILED
  EXPIRED
}

model Player {
  id Int @id @default(autoincrement())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username String @unique

  // Career
  level      Int         @default(1)
  xp         Int         @default(0)
  careerPath CareerPath?

  // Credits are effectively the player's health
  credits Int @default(1000)

  // Action resource
  energy    Int @default(20)
  maxEnergy Int @default(20)

  // PvP
  kills        Int @default(0)
  bankruptcies Int @default(0)

  // Ticket performance
  ticketsResolved   Int @default(0)
  correctBounces    Int @default(0)
  incorrectBounces  Int @default(0)
  incorrectResolves Int @default(0)

  // Lifetime statistics
  lifetimeCreditsEarned  Int @default(0)
  lifetimeTicketsHandled Int @default(0)

  // Used later to determine which career paths are actively playing
  lastActiveAt DateTime @default(now())

  // Ticket relationships
  assignedTickets Ticket[] @relation("AssignedTickets")
  sentTickets     Ticket[] @relation("SentTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id Int @id @default(autoincrement())

  title       String
  description String

  // Hidden answer - never show this to the player
  category TicketCategory

  status TicketStatus @default(OPEN)

  maxValue Int
  baseXp   Int @default(10)

  // Player who currently has the ticket
  assignedToId Int
  assignedTo   Player @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: Cascade)

  // Player who most recently bounced the ticket.
  // Null means the game generated it.
  lastSentById Int?
  lastSentBy   Player? @relation("SentTickets", fields: [lastSentById], references: [id], onDelete: SetNull)

  bounceCount Int @default(0)

  resolvedAt DateTime?
  expiredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([lastSentById])
  @@index([status])
  @@index([category])
}

model TicketTemplate {
  id Int @id @default(autoincrement())

  title       String
  description String

  // Hidden correct owner
  category TicketCategory

  difficulty Int @default(1)

  maxValue Int
  baseXp   Int @default(10)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  player Player?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
