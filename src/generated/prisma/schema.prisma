generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CareerPath {
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketCategory {
  SERVICE_DESK
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketSeverity {
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  OPEN
  RESOLVED
  BOUNCED
  FAILED
  EXPIRED
}

/**
 * ============================
 * PVP ATTACK TYPES
 * ============================
 */
enum PvPAttackType {
  PASSWORD_RESET_FLOOD
  SELF_SERVICE_PORTAL_OUTAGE
  NETWORK_OUTAGE
  FAILED_DEPLOYMENT
  PHISHING_CAMPAIGN
  MONITORING_FAILURE
  DNS_FAILURE
  MAJOR_INCIDENT
  EXECUTIVE_ESCALATION
  MAIL_QUEUE_BACKLOG
}

enum PvPAttackStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/**
 * ============================
 * POISON EFFECTS
 * ============================
 */
enum PoisonEffect {
  NONE

  // Normal system tickets arrive faster
  QUEUE_SPEED

  // Selected tickets receive extra SLA age
  SLA_PRESSURE

  // Normal ticket Credit value decays faster
  VALUE_DECAY

  // Wrong resolution penalties increase
  RESOLUTION_PENALTY

  // Hide BREACHING warnings
  MONITORING_FAILURE

  // Bounce attempts have a chance to fail
  BOUNCE_FAILURE

  // Abandonment penalties increase
  ABANDONMENT_PENALTY

  // Special dangerous short-SLA ticket
  EXECUTIVE_ESCALATION

  // Upcoming tickets arrive in a burst
  MAIL_BACKLOG
}

model Player {
  id Int @id @default(autoincrement())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * PLAYER IDENTITY
   * ============================
   * usernameChangedAt is null until
   * the player changes their username.
   * Username changes are limited
   * to once every 30 days.
   */
  username          String    @unique
  usernameChangedAt DateTime?

  /**
   * ============================
   * CURRENT CAREER
   * ============================
   * These reset on bankruptcy.
   */
  level      Int         @default(1)
  xp         Int         @default(0)
  careerPath CareerPath?

  /**
   * ============================
   * CAREER ABILITY
   * ============================
   * Timestamp for when the player's
   * active specialist ability can
   * next be used.
   * Null means immediately ready.
   */
  careerAbilityReadyAt DateTime?

  /**
   * ============================
   * CURRENT CREDITS
   * ============================
   * Credits are both currency
   * and effectively player health.
   * Reset to starting Credits
   * after bankruptcy.
   */
  credits Int @default(1000)

  /**
   * ============================
   * CURRENT RUN PERFORMANCE
   * ============================
   * These are displayed on the
   * dashboard.
   * They reset when the player
   * becomes bankrupt.
   */
  careerTicketsResolved   Int @default(0)
  careerCorrectBounces    Int @default(0)
  careerIncorrectBounces  Int @default(0)
  careerIncorrectResolves Int @default(0)

  /**
   * ============================
   * LIFETIME PVP STATS
   * ============================
   * These never reset.
   */
  kills        Int @default(0)
  bankruptcies Int @default(0)

  /**
   * ============================
   * LIFETIME TICKET PERFORMANCE
   * ============================
   * These never reset.
   * They are shown on the
   * player's profile page.
   */
  ticketsResolved   Int @default(0)
  correctBounces    Int @default(0)
  incorrectBounces  Int @default(0)
  incorrectResolves Int @default(0)

  /**
   * ============================
   * LIFETIME TOTALS
   * ============================
   * These also never reset.
   */
  lifetimeCreditsEarned  Int @default(0)
  lifetimeTicketsHandled Int @default(0)

  /**
   * ============================
   * PVP RELATIONSHIPS
   * ============================
   */
  attacksSent     PvPAttack[] @relation("AttacksSent")
  attacksReceived PvPAttack[] @relation("AttacksReceived")

  /**
   * Tickets originally created
   * by this player as PvP poison.
   */
  attackTickets Ticket[] @relation("AttackTickets")

  /**
   * ============================
   * PLAYER ACTIVITY
   * ============================
   */
  lastActiveAt DateTime @default(now())

  /**
   * Personal queue slowdown after
   * bouncing something they could
   * have resolved.
   */
  queuePenaltyUntil DateTime?

  /**
   * Next automatic system ticket.
   */
  nextTicketAt DateTime?

  /**
   * ============================
   * TICKET RELATIONSHIPS
   * ============================
   */
  assignedTickets Ticket[] @relation("AssignedTickets")
  sentTickets     Ticket[] @relation("SentTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id Int @id @default(autoincrement())

  title       String
  description String

  /**
   * Hidden correct resolver.
   */
  category TicketCategory

  /**
   * Visible urgency.
   */
  severity TicketSeverity @default(P4)

  /**
   * Hidden difficulty.
   * 1 = Easy
   * 2 = Standard
   * 3 = Hard
   * 4 = Expert
   * 5 = Nightmare
   */
  difficulty Int @default(1)

  status TicketStatus @default(OPEN)

  /**
   * ============================
   * REWARDS
   * ============================
   * Normal tickets use:
   * maxValue
   * baseXp
   * Poison Tickets normally use:
   * maxValue = 0
   * baseXp   = 0
   */
  maxValue Int
  baseXp   Int @default(10)

  /**
   * ============================
   * POISON TICKET
   * ============================
   */
  isPoison Boolean @default(false)

  /**
   * Active poison effect attached
   * to this ticket.
   */
  poisonEffect PoisonEffect @default(NONE)

  /**
   * Optional ticket-specific
   * outcome messages.
   */
  successMessage String?
  failureMessage String?

  /**
   * ============================
   * CURRENT OWNER
   * ============================
   */
  assignedToId Int
  assignedTo   Player @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * MOST RECENT BOUNCE
   * ============================
   * Null means the ticket came
   * directly from the game or
   * PvP system.
   */
  lastSentById Int?
  lastSentBy   Player? @relation("SentTickets", fields: [lastSentById], references: [id], onDelete: SetNull)

  /**
   * ============================
   * ORIGINAL PVP ATTACKER
   * ============================
   * Never changes when the
   * Poison Ticket moves between
   * players.
   */
  attackSourcePlayerId Int?
  attackSourcePlayer   Player? @relation("AttackTickets", fields: [attackSourcePlayerId], references: [id], onDelete: SetNull)

  /**
   * ============================
   * PVP ATTACK EVENT
   * ============================
   */
  pvpAttackId Int?
  pvpAttack   PvPAttack? @relation(fields: [pvpAttackId], references: [id], onDelete: SetNull)

  /**
   * Number of times this ticket
   * has moved between queues.
   */
  bounceCount Int @default(0)

  /**
   * ============================
   * ABANDONMENT / SLA
   * ============================
   */
  abandonmentPenaltyApplied Boolean   @default(false)
  abandonmentPenaltyAt      DateTime?

  /**
   * Artificial SLA pressure
   * added by poison attacks.
   * Effective age includes this
   * value without modifying
   * createdAt.
   */
  slaAgeOffsetMinutes Int @default(0)

  /**
   * ============================
   * SYSTEMS - MAINTENANCE WINDOW
   * ============================
   * maintenanceUntil:
   * While this timestamp is in
   * the future, SLA ageing and
   * Credit decay are frozen.
   * maintenancePausedMinutes:
   * Once the Maintenance Window
   * ends, its completed frozen
   * time is permanently stored
   * here.
   */
  maintenanceUntil         DateTime?
  maintenancePausedMinutes Int       @default(0)

  /**
   * ============================
   * COMPLETION TIMES
   * ============================
   */
  resolvedAt DateTime?
  expiredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([lastSentById])
  @@index([attackSourcePlayerId])
  @@index([pvpAttackId])
  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([difficulty])
  @@index([isPoison])
  @@index([poisonEffect])
  @@index([slaAgeOffsetMinutes])
  @@index([maintenanceUntil])
  @@index([abandonmentPenaltyApplied])
}

model TicketTemplate {
  id Int @id @default(autoincrement())

  title       String
  description String

  /**
   * Hidden correct resolver.
   */
  category TicketCategory

  /**
   * Visible urgency.
   */
  severity TicketSeverity @default(P4)

  /**
   * Hidden internal difficulty.
   * 1 = Easy
   * 2 = Standard
   * 3 = Hard
   * 4 = Expert
   * 5 = Nightmare
   */
  difficulty Int @default(1)

  /**
   * ============================
   * REWARDS
   * ============================
   */
  maxValue Int
  baseXp   Int @default(10)

  /**
   * Optional ticket-specific
   * outcome messages.
   */
  successMessage String?
  failureMessage String?

  /**
   * Can be disabled without
   * deleting the template.
   */
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([severity])
  @@index([difficulty])
  @@index([active])
}

/**
 * ============================
 * PVP ATTACK
 * ============================
 * One purchased poison attack.
 * One attack can create one
 * or multiple Poison Tickets.
 */
model PvPAttack {
  id Int @id @default(autoincrement())

  type   PvPAttackType
  status PvPAttackStatus @default(ACTIVE)

  /**
   * Credits paid by attacker.
   */
  cost Int

  /**
   * ============================
   * ATTACKER
   * ============================
   */
  attackerId Int
  attacker   Player @relation("AttacksSent", fields: [attackerId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * ORIGINAL TARGET
   * ============================
   */
  targetId Int
  target   Player @relation("AttacksReceived", fields: [targetId], references: [id], onDelete: Cascade)

  /**
   * Poison Tickets generated
   * by this attack.
   */
  tickets Ticket[]

  /**
   * True when this attack
   * directly causes bankruptcy.
   */
  causedBankruptcy Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attackerId])
  @@index([targetId])
  @@index([type])
  @@index([status])
  @@index([causedBankruptcy])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  player Player?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
