generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================
 * CAREER PATHS
 * ============================
 */
enum CareerPath {
  NETWORK
  SYSTEMS
  SECURITY
}

/**
 * ============================
 * TICKET TYPES
 * ============================
 */
enum TicketCategory {
  SERVICE_DESK
  NETWORK
  SYSTEMS
  SECURITY
}

enum TicketSeverity {
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  OPEN
  RESOLVED
  BOUNCED
  FAILED
  EXPIRED
}

/**
 * ============================
 * PVP ATTACK TYPES
 * ============================
 */
enum PvPAttackType {
  PASSWORD_RESET_FLOOD
  SELF_SERVICE_PORTAL_OUTAGE
  NETWORK_OUTAGE
  FAILED_DEPLOYMENT
  PHISHING_CAMPAIGN
  MONITORING_FAILURE
  DNS_FAILURE
  MAJOR_INCIDENT
  EXECUTIVE_ESCALATION
  MAIL_QUEUE_BACKLOG
}

enum PvPAttackStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/**
 * ============================
 * POISON EFFECTS
 * ============================
 */
enum PoisonEffect {
  NONE

  // Normal system tickets arrive faster
  QUEUE_SPEED

  // Selected tickets receive extra SLA age
  SLA_PRESSURE

  // Normal ticket Credit value decays faster
  VALUE_DECAY

  // Wrong resolution penalties increase
  RESOLUTION_PENALTY

  // Hide BREACHING warnings
  MONITORING_FAILURE

  // Bounce attempts have a chance to fail
  BOUNCE_FAILURE

  // Abandonment penalties increase
  ABANDONMENT_PENALTY

  // Special dangerous short-SLA ticket
  EXECUTIVE_ESCALATION

  // Upcoming tickets arrive in a burst
  MAIL_BACKLOG
}

/**
 * ============================
 * FEEDBACK
 * ============================
 */
enum FeedbackType {
  BUG
  SUGGESTION
  BALANCE
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWING
  DONE
  REJECTED
}

/**
 * ============================
 * PLAYER
 * ============================
 */
model Player {
  id Int @id @default(autoincrement())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * PLAYER IDENTITY
   * ============================
   */
  username          String    @unique
  usernameChangedAt DateTime?

  /**
   * ============================
   * CURRENT CAREER
   * ============================
   */
  level      Int         @default(1)
  xp         Int         @default(0)
  careerPath CareerPath?

  /**
   * ============================
   * CAREER ABILITY
   * ============================
   */
  careerAbilityReadyAt DateTime?

  /**
   * ============================
   * CURRENT CREDITS
   * ============================
   */
  credits Int @default(750)

  /**
   * ============================
   * LIFETIME PVP STATS
   * ============================
   */
  kills        Int @default(0)
  bankruptcies Int @default(0)

  /**
   * ============================
   * LIFETIME TICKET PERFORMANCE
   * ============================
   */
  ticketsResolved   Int @default(0)
  correctBounces    Int @default(0)
  incorrectBounces  Int @default(0)
  incorrectResolves Int @default(0)

  /**
   * ============================
   * LIFETIME TOTALS
   * ============================
   */
  lifetimeCreditsEarned  Int @default(0)
  lifetimeTicketsHandled Int @default(0)

  /**
   * ============================
   * PVP RELATIONSHIPS
   * ============================
   */
  attacksSent     PvPAttack[] @relation("AttacksSent")
  attacksReceived PvPAttack[] @relation("AttacksReceived")

  /**
   * Tickets originally created
   * by this player as PvP poison.
   */
  attackTickets Ticket[] @relation("AttackTickets")

  /**
   * ============================
   * PLAYER ACTIVITY
   * ============================
   */
  lastActiveAt DateTime @default(now())

  /**
   * Personal queue slowdown after
   * bouncing something they could
   * have resolved.
   */
  queuePenaltyUntil DateTime?

  /**
   * Next automatic system ticket.
   */
  nextTicketAt DateTime?

  /**
   * ============================
   * TICKET RELATIONSHIPS
   * ============================
   */
  assignedTickets Ticket[] @relation("AssignedTickets")
  sentTickets     Ticket[] @relation("SentTickets")

  /**
   * ============================
   * FEEDBACK
   * ============================
   */
  feedback Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ============================
 * TICKET
 * ============================
 */
model Ticket {
  id Int @id @default(autoincrement())

  title       String
  description String

  /**
   * Hidden correct resolver.
   */
  category TicketCategory

  /**
   * Visible urgency.
   */
  severity TicketSeverity @default(P4)

  /**
   * Hidden difficulty.
   * 1 = Easy
   * 2 = Standard
   * 3 = Hard
   * 4 = Expert
   * 5 = Nightmare
   */
  difficulty Int @default(1)

  status TicketStatus @default(OPEN)

  /**
   * ============================
   * REWARDS
   * ============================
   */
  maxValue Int
  baseXp   Int @default(10)

  /**
   * ============================
   * POISON TICKET
   * ============================
   */
  isPoison Boolean @default(false)

  /**
   * Active poison effect attached
   * to this ticket.
   */
  poisonEffect PoisonEffect @default(NONE)

  /**
   * Optional ticket-specific
   * outcome messages.
   */
  successMessage String?
  failureMessage String?

  /**
   * ============================
   * CURRENT OWNER
   * ============================
   */
  assignedToId Int
  assignedTo   Player @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * MOST RECENT BOUNCE
   * ============================
   */
  lastSentById Int?
  lastSentBy   Player? @relation("SentTickets", fields: [lastSentById], references: [id], onDelete: SetNull)

  /**
   * ============================
   * ORIGINAL PVP ATTACKER
   * ============================
   */
  attackSourcePlayerId Int?
  attackSourcePlayer   Player? @relation("AttackTickets", fields: [attackSourcePlayerId], references: [id], onDelete: SetNull)

  /**
   * ============================
   * PVP ATTACK EVENT
   * ============================
   */
  pvpAttackId Int?
  pvpAttack   PvPAttack? @relation(fields: [pvpAttackId], references: [id], onDelete: SetNull)

  /**
   * Number of times this ticket
   * has moved between queues.
   */
  bounceCount Int @default(0)

  /**
   * ============================
   * ABANDONMENT / SLA
   * ============================
   */
  abandonmentPenaltyApplied Boolean   @default(false)
  abandonmentPenaltyAt      DateTime?

  /**
   * Artificial SLA pressure
   * added by poison attacks.
   */
  slaAgeOffsetMinutes Int @default(0)

  /**
   * ============================
   * SYSTEMS - MAINTENANCE WINDOW
   * ============================
   */
  maintenanceUntil         DateTime?
  maintenancePausedMinutes Int       @default(0)

  /**
   * ============================
   * COMPLETION TIMES
   * ============================
   */
  resolvedAt DateTime?
  expiredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([lastSentById])
  @@index([attackSourcePlayerId])
  @@index([pvpAttackId])
  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([difficulty])
  @@index([isPoison])
  @@index([poisonEffect])
  @@index([slaAgeOffsetMinutes])
  @@index([maintenanceUntil])
  @@index([abandonmentPenaltyApplied])
}

/**
 * ============================
 * TICKET TEMPLATE
 * ============================
 */
model TicketTemplate {
  id Int @id @default(autoincrement())

  title       String
  description String

  /**
   * Hidden correct resolver.
   */
  category TicketCategory

  /**
   * Visible urgency.
   */
  severity TicketSeverity @default(P4)

  /**
   * Hidden internal difficulty.
   * 1 = Easy
   * 2 = Standard
   * 3 = Hard
   * 4 = Expert
   * 5 = Nightmare
   */
  difficulty Int @default(1)

  /**
   * ============================
   * REWARDS
   * ============================
   */
  maxValue Int
  baseXp   Int @default(10)

  /**
   * Optional ticket-specific
   * outcome messages.
   */
  successMessage String?
  failureMessage String?

  /**
   * Can be disabled without
   * deleting the template.
   */
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([severity])
  @@index([difficulty])
  @@index([active])
}

/**
 * ============================
 * PLAYER FEEDBACK
 * ============================
 */
model Feedback {
  id Int @id @default(autoincrement())

  /**
   * ============================
   * FEEDBACK DETAILS
   * ============================
   */
  type   FeedbackType
  status FeedbackStatus @default(NEW)

  /**
   * Feedback body submitted
   * by the player.
   */
  message String

  /**
   * ============================
   * PLAYER
   * ============================
   */
  playerId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * ADMIN NOTES
   * ============================
   *
   * Internal notes for admins.
   * These are not intended to
   * be shown to players.
   */
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/**
 * ============================
 * PVP ATTACK
 * ============================
 */
model PvPAttack {
  id Int @id @default(autoincrement())

  type   PvPAttackType
  status PvPAttackStatus @default(ACTIVE)

  /**
   * Credits paid by attacker.
   */
  cost Int

  /**
   * ============================
   * ATTACKER
   * ============================
   */
  attackerId Int
  attacker   Player @relation("AttacksSent", fields: [attackerId], references: [id], onDelete: Cascade)

  /**
   * ============================
   * ORIGINAL TARGET
   * ============================
   */
  targetId Int
  target   Player @relation("AttacksReceived", fields: [targetId], references: [id], onDelete: Cascade)

  /**
   * Poison Tickets generated
   * by this attack.
   */
  tickets Ticket[]

  /**
   * True when this attack
   * directly causes bankruptcy.
   */
  causedBankruptcy Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attackerId])
  @@index([targetId])
  @@index([type])
  @@index([status])
  @@index([causedBankruptcy])
}

/**
 * ============================
 * BETTER AUTH USER
 * ============================
 */
model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?

  /**
   * ============================
   * BETTER AUTH ADMIN
   * ============================
   *
   * Normal accounts use:
   * role = "user"
   *
   * Administrators use:
   * role = "admin"
   */
  role String? @default("user")

  /**
   * Ban / suspension fields
   * used by Better Auth Admin.
   */
  banned     Boolean? @default(false)
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  player Player?

  @@unique([email])
  @@index([role])
  @@index([banned])
  @@map("user")
}

/**
 * ============================
 * BETTER AUTH SESSION
 * ============================
 */
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  userId String

  /**
   * ============================
   * BETTER AUTH ADMIN
   * ============================
   *
   * Used when an admin
   * impersonates another user.
   */
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([impersonatedBy])
  @@map("session")
}

/**
 * ============================
 * BETTER AUTH ACCOUNT
 * ============================
 */
model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

/**
 * ============================
 * BETTER AUTH VERIFICATION
 * ============================
 */
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}